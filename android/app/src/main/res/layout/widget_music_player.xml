<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="专辑封面"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher_round" />

    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="小庞奶娃音乐"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="轻点封面打开播放器"
            android:textColor="#B8CBD8"
            android:textSize="11.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_btn_prev"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@android:color/transparent"
        android:contentDescription="上一首"
        android:padding="5dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#E6FFFFFF" />

    <ImageButton
        android:id="@+id/widget_btn_play_pause"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_play_btn_bg"
        android:contentDescription="播放或暂停"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/widget_btn_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@android:color/transparent"
        android:contentDescription="下一首"
        android:padding="5dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_media_next"
        android:tint="#E6FFFFFF" />
</LinearLayout>
